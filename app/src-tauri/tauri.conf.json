{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Equavela",
  "version": "0.1.0",
  "identifier": "local.equavela.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Equavela",
        "width": 1280,
        "height": 800,
        "visible": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Equavela",
    "shortDescription": "Equavela, a scientific computing workspace",
    "longDescription": "Worksheets with live calculation, units, plots and symbolics (Julia kernel, SymPy).",
    "category": "Education",
    "fileAssociations": [
      {
        "ext": [
          "eqv"
        ],
        "name": "Equavela worksheet",
        "description": "Equavela worksheet",
        "mimeType": "application/x-equavela-worksheet",
        "role": "Editor"
      },
      {
        "ext": [
          "eqvz"
        ],
        "name": "Equavela portable document",
        "description": "Equavela portable document",
        "mimeType": "application/x-equavela-portable",
        "role": "Editor"
      }
    ]
  }
}
