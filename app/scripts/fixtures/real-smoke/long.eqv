format: equavela-worksheet/3
page:
  size: A4
  margins: {top: 72, right: 54, bottom: 72, left: 54}
regions:
  - id: a1
    page: 1
    at: [54, 72]
    math: "a := 1"
  - id: p1
    page: 1
    at: [54, 110]
    math: |
      Long(n) := program
        s ← 0
        for i ∈ 1..n
          s ← s + i
        s
  - id: p2
    page: 1
    at: [54, 250]
    math: "Long(10000000000) ="
  - id: a2
    page: 1
    at: [54, 300]
    math: "a + 1 ="
