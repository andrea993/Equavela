<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared MIME info for Equavela worksheets.
     The match is the magic first line `format: equavela-worksheet/` at offset 0
; the glob has a lower weight and only applies when no magic
     is available. Files of the former name (`.mm`) are not associated: Objective-C++ and
     FreeMind/Freeplane own that glob; Equavela still opens them. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-equavela-worksheet">
    <comment>Equavela worksheet</comment>
    <sub-class-of type="text/plain"/>
    <magic priority="80">
      <match type="string" value="format: equavela-worksheet/" offset="0"/>
      <!-- the same line after a UTF-8 byte order mark -->
      <match type="string" value="&#xFEFF;format: equavela-worksheet/" offset="0"/>
    </magic>
    <glob pattern="*.eqv" weight="30"/>
  </mime-type>
  <!-- A portable document is a ZIP archive. -->
  <mime-type type="application/x-equavela-portable">
    <comment>Equavela portable document</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.eqvz"/>
  </mime-type>
</mime-info>
