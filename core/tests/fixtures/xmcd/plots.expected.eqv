format: equavela-worksheet/3
page:
  size: A4
  margins: {top: 72, right: 54, bottom: 72, left: 54}
regions:
  - id: r1
    page: 1
    at: [126, 72]
    plot:
      version: 1
      type: xy
      size: [159.75, 129.75]
      axes:
        x: {min: -5, max: 5, show_grid: false}
        y: {min: -2, max: 2, show_grid: false}
        y2: {show_grid: false}
      traces:
        - {id: trace-1, x: "t", y: "sin(t)", line: {color: "#ff0000"}, show_in_legend: false}
  - id: r2
    page: 1
    at: [126, 222]
    plot:
      version: 1
