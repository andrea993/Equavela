        y: {show_grid: false}
        y2: {show_grid: false}
      traces:
        - {id: trace-1, x: "t", y: "sin(t)", line: {color: "#ff0000"}, show_in_legend: false}
        - {id: trace-2, x: "t", y: "cos(t)", line: {style: dot, color: "#0000ff"}, show_in_legend: false}
