format: equavela-worksheet/3
page:
  size: A4
  margins: {top: 72, right: 54, bottom: 72, left: 54}
regions:
  - id: r1
    page: 1
    at: [54, 72]
    plot:
      version: 1
      type: xy
      size: [300, 195]
      axes:
        x: {position: origin}
      traces:
        - {id: trace-1, x: "t", y: "A", line: {width: 1, color: "#0000FF"}, show_in_legend: false}
  - id: r2
    page: 1
    at: [54, 297]
    plot:
      version: 1
      type: xy
      size: [300, 195]
      axes:
        x: {position: origin}
      traces:
        - {id: trace-1, x: "t", y: "B", line: {width: 1, color: "#0000FF"}, show_in_legend: false}
